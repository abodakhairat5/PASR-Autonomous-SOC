{
  "name": "@pentesterflow/agent",
  "version": "0.1.0-dev",
  "description": "Agentic offensive-security CLI for security engineers, professional penetration testers, and bug hunters.",
  "type": "module",
  "bin": {
    "pentesterflow": "./dist/cli.js",
    "pentesterflow-browser-mcp": "./dist/browser-mcp.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "dev:burp": "tsx src/cli/index.ts --burp",
    "web": "tsx src/web/index.ts",
    "dev:web": "tsx watch src/web/index.ts",
    "dev:ui": "vite src/web/frontend",
    "build:ui": "vite build src/web/frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "report": "tsx scripts/generate-report.ts"
  },
  "keywords": [
    "pentest",
    "bug-bounty",
    "security",
    "cli",
    "agent",
    "llm",
    "ollama",
    "mcp",
    "offensive-security",
    "red-team"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/pentesterflow/agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/pentesterflow/agent.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/sse": "^0.6.0",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@tanstack/react-query": "^5.102.8",
    "better-sqlite3": "^13.0.3",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "execa": "^9.5.1",
    "fast-glob": "^3.3.2",
    "fastify": "^5.12.1",
    "gray-matter": "^4.0.3",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "marked": "^14.1.4",
    "marked-terminal": "^7.2.1",
    "pino": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "undici": "^6.21.0",
    "write-file-atomic": "^6.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.10.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "ink-testing-library": "^4.0.0",
    "pdfkit": "^0.20.2",
    "pino-pretty": "^13.0.0",
    "react-devtools-core": "^4.28.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
